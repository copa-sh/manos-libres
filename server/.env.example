# Dónde escucha el nodo. En Docker lo fija compose; ejecutando el binario a mano, aquí.
HOST=127.0.0.1
PORT=8787

# Puerto publicado en la máquina por compose. Dentro del contenedor siempre es el 8787,
# porque es a donde apuntan el mapeo y el proxy de Caddy.
PUERTO_LOCAL=8787

# Dominio con el que Caddy saca el certificado y sirve HTTP/3.
NODO_DOMINIO=agente.example.com

# Directorios donde se permite abrir sesiones de agente. Separados por ':'.
# Se rechaza cualquier cwd que no esté bajo una de estas raíces.
#
# Ojo con lo que esto NO cubre: el CLI carga el CLAUDE.md, las skills y los hooks del
# directorio, y no hay forma de impedirlo sin perder la suscripción (ver claudecode.go).
# Un repo bajo una raíz permitida puede traer código que se ejecuta solo.
ALLOWED_ROOTS=/home/tu-usuario/proyectos
PROYECTOS=/home/tu-usuario/proyectos

# Token de dispositivo para desarrollo. Viaja en `Authorization: Bearer`, no en la URL.
# En producción se usa el emparejamiento con clave Ed25519 del Keystore (H6).
#   openssl rand -hex 32
DEV_TOKEN=cambia-esto-por-algo-aleatorio-de-32-bytes

# Frames por sesión que se conservan para el replay tras reconectar.
REPLAY_BUFFER=500

# Silencio en segundos antes de mandar un keepalive por el canal SSE. Es lo que se paga en
# batería por tener el canal abierto: subirlo ahorra, pero se arriesga a que el NAT de la
# operadora cierre la conexión sin avisar.
KEEPALIVE_SEGUNDOS=20

# Motor por defecto: 'claude-code' es el único implementado.
DEFAULT_ENGINE=claude-code

# Modelo que usa el agente (alias del CLI: opus, sonnet, fable).
AGENT_MODEL=opus

# Binario de Claude Code. La versión importa: el nodo usa `-p` SIN `--bare`, y la
# documentación dice que `--bare` pasará a ser el defecto de `-p`. Cuando eso ocurra, el CLI
# dejará de leer las credenciales OAuth y exigirá ANTHROPIC_API_KEY — es decir, dejaría de
# consumir la suscripción y empezaría a facturar por token, en silencio. Fija la versión.
CLAUDE_BIN=claude

# --- Credenciales ---
# Deliberadamente NO se define ANTHROPIC_API_KEY: sin ella, el CLI usa las credenciales
# OAuth de ~/.claude del usuario que ejecuta el nodo. Eso es lo que hace que se consuma la
# SUSCRIPCIÓN y no la API de pago. Haz `claude login` una vez en el servidor.
#
# Si defines ANTHROPIC_API_KEY, se facturará por token contra la API.
# ANTHROPIC_API_KEY=

# --- Versión del CLI ---
# Versión de `claude --version` con la que se probó el nodo. Si la instalada es otra (o esto
# está vacío) el nodo lo avisa en el log al arrancar; no se niega a arrancar.
CLAUDE_VERSION=

# --- Sesiones ---
# Minutos sin actividad (y sin nadie siguiéndola ni decisiones pendientes) tras los que se
# cierra una sesión ociosa. 0 = nunca.
SESSION_IDLE_MINUTES=240

# Dónde se guardan las sesiones cerradas para reanudarlas con `--resume` tras reiniciar el
# nodo (POST /v1/sesiones con {"resume":"s_3"}). Vacío no desactiva: usa el defecto.
STATE_FILE=estado.json

# --- Límites (docs/05-seguridad.md §Límites de tasa y abuso) ---
LIMITE_ABRIR_MIN=3
LIMITE_PROMPT_MIN=30
MAX_CONEXIONES_TOKEN=4
MAX_CONEXIONES_NODO=20
MAX_FALLOS_AUTH=5
