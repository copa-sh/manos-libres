<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.ManosLibres" parent="android:Theme.Material.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowBackground">@color/bg_1</item>
        <item name="android:textColor">@color/foreground</item>
    </style>

    <!--
        Modo A. Negro puro, no gris oscuro: en un panel OLED un píxel negro está apagado, y
        eso es lo que hace que «pantalla encendida pero invisible» consuma como una pantalla
        apagada. El brillo se pone a 0 en tiempo de ejecución.
    -->
    <style name="Theme.ManosLibres.Negra" parent="Theme.ManosLibres">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentOverlay">@null</item>
    </style>

    <!-- La botonera ocupa hasta los bordes: sin insets, sin barras, sin márgenes. -->
    <style name="Theme.ManosLibres.Decision" parent="Theme.ManosLibres">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
    </style>

</resources>
