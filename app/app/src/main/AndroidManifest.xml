<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <!-- Que una decisión llegue a pantalla completa con el móvil bloqueado. -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <!-- Sin push por un tercero, la exención de Doze es parte de la entrega (docs/07 §3). -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- Visibilidad de paquetes (Android 11+): sin esto TextToSpeech no encuentra ningún motor. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>

    <application
        android:label="@string/app_name"
        android:theme="@style/Theme.ManosLibres"
        android:supportsRtl="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Emparejamiento por enlace: manoslibres://pair?url=...&token=... -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="manoslibres" android:host="pair" />
            </intent-filter>
        </activity>

        <!--
            Modo A: pantalla negra con gestos. `showWhenLocked` y `turnScreenOn` para que
            entrar en narración no exija desbloquear. Sin `windowSoftInputMode` porque aquí
            no se escribe nada, nunca.
        -->
        <activity
            android:name=".input.BlackScreenActivity"
            android:exported="false"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:excludeFromRecents="true"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:theme="@style/Theme.ManosLibres.Negra" />

        <!--
            La botonera de decisión. `showWhenLocked` es lo que hace que se pueda contestar
            sin desbloquear: es el camino crítico de toda la app.
        -->
        <activity
            android:name=".ui.DecisionActivity"
            android:exported="false"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:excludeFromRecents="true"
            android:launchMode="singleInstance"
            android:theme="@style/Theme.ManosLibres.Decision" />

        <!--
            Mantiene el canal con el nodo y la narración con la pantalla bloqueada. Se declara como
            reproducción de medios porque narrar es reproducir audio: así el sistema lo
            respeta y la narración aparece en los controles de la pantalla de bloqueo.
        -->
        <service
            android:name=".session.SessionService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <!--
            Las acciones de la notificación de decisión: contestar desde la pantalla de
            bloqueo. No exportado: solo lo dispara el PendingIntent de la propia app.
        -->
        <receiver
            android:name=".session.DecisionReceiver"
            android:exported="false" />

    </application>
</manifest>
